{
  "name": "t3-vscode",
  "displayName": "T3 VSCode",
  "description": "Alpha client for local T3 Code servers: workspace sessions, editor chat, rich messages and account usage.",
  "version": "0.1.21",
  "publisher": "hungtienhuang",
  "repository": {
    "type": "git",
    "url": "https://github.com/busFred/t3-vscode.git"
  },
  "private": true,
  "type": "module",
  "main": "./dist/extension.mjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "t3-sidebar",
          "title": "T3 VSCode",
          "icon": "resources/t3-icon.svg"
        }
      ]
    },
    "views": {
      "t3-sidebar": [
        {
          "type": "webview",
          "id": "t3.webview",
          "name": "T3 VSCode"
        },
        {
          "id": "t3-vscode.ours.drop.view",
          "name": "Drop files here (no Shift needed)",
          "when": "config.t3-vscode.ours.drop.showView",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "t3-vscode.ours.chat.nextWaiting",
        "title": "Go to Next Chat That Needs You",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.ours.viewbar.sessions",
        "title": "Back to Sessions",
        "category": "T3 VSCode",
        "icon": "$(arrow-left)"
      },
      {
        "command": "t3-vscode.ours.viewbar.popOut",
        "title": "Open This Chat in an Editor Tab",
        "category": "T3 VSCode",
        "icon": "$(empty-window)"
      },
      {
        "command": "t3-vscode.ours.chat.focus",
        "title": "Focus Chat Input",
        "category": "T3 VSCode",
        "icon": {
          "light": "resources/t3-tab-light.svg",
          "dark": "resources/t3-tab-dark.svg"
        }
      },
      {
        "command": "t3-vscode.ours.chat.new",
        "title": "New Chat",
        "category": "T3 VSCode",
        "icon": "$(add)"
      },
      {
        "command": "t3-vscode.ours.threadActions.more",
        "title": "Thread Actions",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.ours.diffs.compare",
        "title": "Compare with Current File",
        "category": "T3 VSCode",
        "icon": "$(git-compare)"
      },
      {
        "command": "t3-vscode.ours.threadActions.regenerateTitle",
        "title": "Regenerate Title",
        "category": "T3 VSCode",
        "icon": "$(sparkle)"
      },
      {
        "command": "t3-vscode.ours.diffs.openFile",
        "title": "Open File",
        "category": "T3 VSCode",
        "icon": "$(go-to-file)"
      },
      {
        "command": "t3-vscode.ours.diffs.revert",
        "title": "Revert File to Before This Turn",
        "category": "T3 VSCode",
        "icon": "$(discard)"
      },
      {
        "command": "t3-vscode.ours.log.show",
        "title": "Show Logs",
        "category": "T3 VSCode",
        "icon": "$(output)"
      },
      {
        "command": "t3-vscode.ours.chat.switch",
        "title": "Switch Chat",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.ours.sidebar.moveToSidebar",
        "title": "Move Chat to Side Panel",
        "category": "T3 VSCode",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "t3-vscode.ours.drop.copy",
        "title": "Copy Files for a Paste into T3 Code",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.ours.mcp.setup",
        "title": "Set Up the VS Code Context Server",
        "category": "T3 VSCode",
        "icon": "$(plug)"
      },
      {
        "command": "t3-vscode.ours.mcp.addClaude",
        "title": "Add the VS Code Context Server to Claude Code",
        "category": "T3 VSCode",
        "icon": "$(terminal)"
      },
      {
        "command": "t3-vscode.ours.mcp.addCodex",
        "title": "Add the VS Code Context Server to Codex",
        "category": "T3 VSCode",
        "icon": "$(terminal)"
      },
      {
        "command": "t3-vscode.ours.mcp.nudge",
        "title": "Ask Once About the VS Code Context Server",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.ours.prompt.addFiles",
        "title": "Add to T3 Prompt",
        "category": "T3 VSCode",
        "icon": "$(add)"
      },
      {
        "command": "t3-vscode.ours.prompt.addTerminalSelection",
        "title": "Add Terminal Selection to T3 Prompt",
        "category": "T3 VSCode",
        "icon": "$(terminal)"
      },
      {
        "command": "t3-vscode.ours.prompt.addLastCommand",
        "title": "Add Last Command to T3 Prompt",
        "category": "T3 VSCode",
        "icon": "$(history)"
      },
      {
        "command": "t3-vscode.ours.prompt.fix",
        "title": "Fix with T3",
        "category": "T3 VSCode",
        "icon": "$(lightbulb)"
      },
      {
        "command": "t3-vscode.ours.prompt.reviewChanges",
        "title": "Review Changes with T3",
        "category": "T3 VSCode",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "t3-vscode.ours.desktop.open",
        "title": "Open This Thread in the T3 App",
        "category": "T3 VSCode",
        "icon": "$(link-external)"
      },
      {
        "command": "t3-vscode.ours.links.copy",
        "title": "Copy Link to This Thread",
        "category": "T3 VSCode",
        "icon": "$(link)"
      },
      {
        "command": "t3-vscode.ours.statusbar.open",
        "title": "Open the Session That Needs You",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.openInTab",
        "title": "Open New Chat in Editor Tab",
        "category": "T3 VSCode",
        "icon": "$(add)"
      },
      {
        "command": "t3-vscode.newThread",
        "title": "New Thread",
        "category": "T3 VSCode",
        "icon": "$(add)"
      },
      {
        "command": "t3-vscode.showUsage",
        "title": "Account & Usage",
        "category": "T3 VSCode",
        "icon": "$(graph)"
      },
      {
        "command": "t3-vscode.showThreads",
        "title": "Sessions",
        "category": "T3 VSCode",
        "icon": "$(history)"
      },
      {
        "command": "t3-vscode.threadActions",
        "title": "Thread Actions",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.pair",
        "title": "Pair with T3 Server",
        "category": "T3 VSCode",
        "icon": "$(plug)"
      },
      {
        "command": "t3-vscode.fontSettings",
        "title": "Font Settings",
        "category": "T3 VSCode",
        "icon": "$(text-size)"
      },
      {
        "command": "t3-vscode.insertReference",
        "title": "Reference Editor Selection",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.reconnect",
        "title": "Reconnect to T3 Server",
        "category": "T3 VSCode",
        "icon": "$(refresh)"
      },
      {
        "command": "t3-vscode.openWebUi",
        "title": "Open Web UI",
        "category": "T3 VSCode",
        "icon": "$(globe)"
      },
      {
        "command": "t3-vscode.refreshUsage",
        "title": "Refresh Usage Meters",
        "category": "T3 VSCode",
        "icon": "$(refresh)"
      },
      {
        "command": "t3-vscode.configureUsage",
        "title": "Configure Status Meters",
        "category": "T3 VSCode",
        "icon": "$(graph)"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.action.openPreviousRecentlyUsedEditorInGroup",
        "key": "ctrl+alt+c",
        "when": "t3-vscode.ours.inT3Tab && !editorTextFocus"
      },
      {
        "command": "workbench.action.focusActiveEditorGroup",
        "key": "ctrl+alt+c",
        "when": "t3-vscode.ours.inT3 && !t3-vscode.ours.inT3Tab && !editorTextFocus"
      },
      {
        "command": "t3-vscode.ours.chat.new",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "t3-vscode.ours.inT3 && !editorTextFocus && !terminalFocus && !inputFocus && !listFocus"
      },
      {
        "command": "t3-vscode.ours.chat.nextWaiting",
        "key": "ctrl+alt+w",
        "when": "t3-vscode.ours.ready"
      },
      {
        "command": "t3-vscode.ours.chat.focus",
        "key": "ctrl+alt+c",
        "when": "(!t3-vscode.ours.inT3 || editorTextFocus) && focusedView != 'workbench.debug.watchExpressionsView'"
      },
      {
        "command": "t3-vscode.ours.chat.focus",
        "key": "ctrl+alt+c"
      },
      {
        "command": "t3-vscode.ours.chat.new",
        "key": "ctrl+alt+shift+n"
      },
      {
        "command": "t3-vscode.ours.chat.switch",
        "key": "ctrl+alt+s"
      },
      {
        "command": "t3-vscode.insertReference",
        "key": "shift+alt+k",
        "mac": "shift+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "t3-vscode.ours.drop.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "filesExplorerFocus && foldersViewVisible && !inputFocus && t3-vscode.ours.active"
      },
      {
        "command": "t3-vscode.insertReference",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      },
      {
        "command": "t3-vscode.insertReference",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "t3-vscode.ours.prompt.addFiles",
          "group": "t3ours"
        }
      ],
      "editor/title": [
        {
          "command": "t3-vscode.ours.chat.focus",
          "group": "navigation"
        },
        {
          "command": "t3-vscode.ours.threadActions.more",
          "when": "activeWebviewPanelId == 't3Panel' && t3-vscode.ours.hasThread",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.ours.diffs.compare",
          "when": "resourceScheme == t3-turn-diff",
          "group": "navigation"
        },
        {
          "command": "t3-vscode.ours.diffs.openFile",
          "when": "resourceScheme == t3-turn-diff || resourceScheme == t3-ours-diff",
          "group": "navigation"
        },
        {
          "command": "t3-vscode.ours.diffs.revert",
          "when": "resourceScheme == t3-turn-diff || resourceScheme == t3-ours-diff",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.ours.links.copy",
          "when": "activeWebviewPanelId == 't3Panel' && t3-vscode.ours.hasThread",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.ours.sidebar.moveToSidebar",
          "when": "activeWebviewPanelId == 't3Panel' && config.t3-vscode.ours.layout.openThreadsIn != 'editor'",
          "group": "navigation"
        },
        {
          "command": "t3-vscode.ours.desktop.open",
          "when": "activeWebviewPanelId == 't3Panel'",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "t3-vscode.ours.prompt.addFiles",
          "when": "resourceScheme == file",
          "group": "t3ours"
        }
      ],
      "terminal/context": [
        {
          "command": "t3-vscode.ours.prompt.addTerminalSelection",
          "when": "terminalTextSelected",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.ours.prompt.addLastCommand",
          "group": "t3ours"
        }
      ],
      "scm/title": [
        {
          "command": "t3-vscode.ours.prompt.reviewChanges",
          "when": "scmProvider == git",
          "group": "t3ours"
        }
      ],
      "view/item/context": [],
      "commandPalette": [
        {
          "command": "t3-vscode.ours.chat.nextWaiting",
          "when": "t3-vscode.ours.ready"
        },
        {
          "command": "t3-vscode.ours.viewbar.sessions",
          "when": "false"
        },
        {
          "command": "t3-vscode.ours.viewbar.popOut",
          "when": "false"
        },
        {
          "command": "t3-vscode.threadActions",
          "when": "false"
        },
        {
          "command": "t3-vscode.ours.threadActions.more",
          "when": "t3-vscode.ours.hasThread"
        },
        {
          "command": "t3-vscode.ours.diffs.compare",
          "when": "resourceScheme == t3-turn-diff"
        },
        {
          "command": "t3-vscode.ours.diffs.openFile",
          "when": "resourceScheme == t3-turn-diff || resourceScheme == t3-ours-diff || diffEditorModifiedUri =~ /^t3-ours-diff:/ || diffEditorOriginalUri =~ /^t3-ours-diff:/"
        },
        {
          "command": "t3-vscode.ours.diffs.revert",
          "when": "resourceScheme == t3-turn-diff || resourceScheme == t3-ours-diff || diffEditorModifiedUri =~ /^t3-ours-diff:/ || diffEditorOriginalUri =~ /^t3-ours-diff:/"
        },
        {
          "command": "t3-vscode.ours.threadActions.regenerateTitle",
          "when": "t3-vscode.ours.hasThread"
        },
        {
          "command": "t3-vscode.openWebUi",
          "when": "t3-vscode.ours.ready"
        },
        {
          "command": "t3-vscode.refreshUsage",
          "when": "t3-vscode.ours.ready"
        },
        {
          "command": "t3-vscode.ours.links.copy",
          "when": "t3-vscode.ours.hasThread"
        },
        {
          "command": "t3-vscode.ours.sidebar.moveToSidebar",
          "when": "activeWebviewPanelId == 't3Panel' && config.t3-vscode.ours.layout.openThreadsIn != 'editor'"
        },
        {
          "command": "t3-vscode.ours.drop.copy",
          "when": "false"
        },
        {
          "command": "t3-vscode.ours.mcp.nudge",
          "when": "false"
        },
        {
          "command": "t3-vscode.ours.prompt.fix",
          "when": "false"
        },
        {
          "command": "t3-vscode.ours.statusbar.open",
          "when": "false"
        },
        {
          "command": "t3-vscode.newThread",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "t3-vscode.ours.diffs.openFile",
          "when": "resourceScheme == t3-turn-diff || resourceScheme == t3-ours-diff || diffEditorModifiedUri =~ /^t3-ours-diff:/ || diffEditorOriginalUri =~ /^t3-ours-diff:/",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.ours.diffs.revert",
          "when": "resourceScheme == t3-turn-diff || resourceScheme == t3-ours-diff || diffEditorModifiedUri =~ /^t3-ours-diff:/ || diffEditorOriginalUri =~ /^t3-ours-diff:/",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.insertReference",
          "when": "editorTextFocus",
          "group": "t3"
        }
      ],
      "view/title": [
        {
          "command": "t3-vscode.ours.chat.new",
          "when": "view == t3.webview && !t3-vscode.ours.sidebarChat",
          "group": "navigation@1"
        },
        {
          "command": "t3-vscode.ours.viewbar.sessions",
          "when": "view == t3.webview && t3-vscode.ours.sidebarChat",
          "group": "navigation@1"
        },
        {
          "command": "t3-vscode.ours.viewbar.popOut",
          "when": "view == t3.webview && t3-vscode.ours.sidebarChat",
          "group": "navigation@2"
        },
        {
          "command": "t3-vscode.ours.threadActions.more",
          "when": "view == t3.webview && t3-vscode.ours.hasThread && (t3-vscode.ours.sidebarChat || config.t3-vscode.ours.layout.openThreadsIn == 'editor')",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.ours.threadActions.regenerateTitle",
          "when": "view == t3.webview && t3-vscode.ours.hasThread && (t3-vscode.ours.sidebarChat || config.t3-vscode.ours.layout.openThreadsIn == 'editor')",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.ours.desktop.open",
          "when": "view == t3.webview && t3-vscode.ours.hasThread && (t3-vscode.ours.sidebarChat || config.t3-vscode.ours.layout.openThreadsIn == 'editor')",
          "group": "navigation@5"
        },
        {
          "command": "t3-vscode.ours.links.copy",
          "when": "view == t3.webview && t3-vscode.ours.hasThread && (t3-vscode.ours.sidebarChat || config.t3-vscode.ours.layout.openThreadsIn == 'editor')",
          "group": "1_thread"
        },
        {
          "command": "t3-vscode.threadActions",
          "when": "false",
          "group": "1_thread"
        },
        {
          "command": "t3-vscode.ours.log.show",
          "when": "view == t3.webview",
          "group": "t3ours"
        },
        {
          "command": "t3-vscode.fontSettings",
          "when": "view == t3.webview",
          "group": "3_appearance"
        },
        {
          "command": "t3-vscode.pair",
          "when": "view == t3.webview",
          "group": "2_connection"
        },
        {
          "command": "t3-vscode.openWebUi",
          "when": "view == t3.webview",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": [
      {
        "title": "Fork: Drop files view",
        "order": 10,
        "properties": {
          "t3-vscode.ours.drop.showView": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "Show the \"Drop files here\" view under the T3 VSCode sidebar. Drag files from the Explorer or a tab onto it and they go into the focused chat. A drag straight onto a chat cannot work, with or without Shift: VS Code does not pass a drag from its own Explorer or tabs into a webview. The other way: select files in the Explorer, press Ctrl+C, and paste them into the chat with Ctrl+V."
          }
        }
      },
      {
        "title": "Fork: Drop files view",
        "order": 10,
        "properties": {
          "t3-vscode.ours.drop.showView": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "Show the \"Drop files here\" view under the T3 VSCode sidebar. Drag files from the Explorer or a tab onto it and they go into the focused chat. A drag straight onto a chat cannot work, with or without Shift: VS Code does not pass a drag from its own Explorer or tabs into a webview. The other way: select files in the Explorer, press Ctrl+C, and paste them into the chat with Ctrl+V."
          }
        }
      },
      {
        "title": "Fork: Chat look",
        "order": 10,
        "properties": {
          "t3-vscode.ours.chatlook.style": {
            "type": "string",
            "enum": [
              "bubbles",
              "plain"
            ],
            "enumDescriptions": [
              "Your messages in a tinted bubble under a You label, the assistant's turn full width behind a left rule, tool rows muted.",
              "The original look of the extension."
            ],
            "default": "bubbles",
            "scope": "window",
            "description": "How the chat sets your messages apart from the assistant's replies."
          }
        }
      },
      {
        "title": "Fork: Plan mode",
        "order": 10,
        "properties": {
          "t3-vscode.ours.planMode.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "description": "Show the Plan/Build toggle and the /plan and /default suggestions in the chat composer when the provider supports plan mode. Mirrors the T3 app's plan mode setting, which the extension cannot read. A chat already in plan mode always shows the toggle."
          }
        }
      },
      {
        "title": "Fork: Notifications",
        "order": 10,
        "properties": {
          "t3-vscode.ours.notify.finished": {
            "type": "string",
            "enum": [
              "unfocused",
              "always",
              "off"
            ],
            "enumDescriptions": [
              "Only while VS Code does not have focus, for example while you are in another app.",
              "Also while you work in VS Code, except for the chat you are reading.",
              "Never."
            ],
            "default": "unfocused",
            "scope": "window",
            "description": "When to show a toast that a T3 turn finished or failed. Approval and question toasts never show for the chat you are reading."
          }
        }
      },
      {
        "title": "Fork: Context Meter",
        "order": 10,
        "properties": {
          "t3-vscode.ours.contextMeter.show": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "Show how full the chat's context window is (for example \"62% context\") next to the send button, when the provider reports it."
          }
        }
      },
      {
        "title": "Fork: Layout",
        "order": 10,
        "properties": {
          "t3-vscode.ours.layout.openThreadsIn": {
            "type": "string",
            "enum": [
              "sidebar",
              "editor"
            ],
            "enumDescriptions": [
              "Show the chat inside the T3 VSCode sidebar view, like the Claude Code and Codex extensions.",
              "Open each chat in its own editor tab."
            ],
            "default": "sidebar",
            "scope": "window",
            "description": "Where a chat opens when you pick a session, start a new chat from the sidebar, or follow a notification, link or status bar item. The sidebar chat has a button to open it in an editor tab."
          }
        }
      },
      {
        "title": "Fork: Add to prompt",
        "order": 10,
        "properties": {
          "t3-vscode.ours.prompt.todoLens": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "Show \"Implement with T3\" above TODO and FIXME comments."
          }
        }
      },
      {
        "title": "Fork: Save on send",
        "order": 10,
        "properties": {
          "t3-vscode.ours.saveOnSend.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "Save all dirty files (untitled ones excepted) before T3 sends a prompt or a queued-message edit, so the agent reads what the editors show."
          }
        }
      },
      {
        "title": "Appearance",
        "order": 1,
        "properties": {
          "t3-vscode.fontSizeInterface": {
            "type": "integer",
            "default": 16,
            "minimum": 12,
            "maximum": 20,
            "scope": "window",
            "markdownDescription": "Base font size in pixels for T3 chat text, navigation and labels. Matches T3 Code's interface scaling. Changes apply immediately to the sidebar and all T3 editor tabs.",
            "order": 1
          },
          "t3-vscode.fontSizePrompt": {
            "type": "integer",
            "default": 14,
            "minimum": 12,
            "maximum": 20,
            "scope": "window",
            "description": "Font size in pixels for message and queued-message editors, independent of interface and code sizes. Changes apply immediately.",
            "order": 2
          },
          "t3-vscode.fontSizeCode": {
            "type": "integer",
            "default": 13,
            "minimum": 10,
            "maximum": 18,
            "scope": "window",
            "description": "Font size in pixels for code blocks, diffs and tool output, independent of interface and prompt sizes. Changes apply immediately.",
            "order": 3
          }
        }
      },
      {
        "title": "Reading",
        "order": 2,
        "properties": {
          "t3-vscode.messageNavigation": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "off"
            ],
            "enumDescriptions": [
              "Show the message rail on the left.",
              "Show the message rail on the right.",
              "Hide the message rail."
            ],
            "default": "left",
            "scope": "window",
            "description": "Placement of the message navigation rail in editor chats. Hover or scroll over it to preview prompts, then click to jump. Changes apply immediately.",
            "order": 1
          }
        }
      },
      {
        "title": "Usage",
        "order": 3,
        "properties": {
          "t3-vscode.usage.followActiveConversation": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "Show the remaining subscription limits of the provider used by the focused conversation. Month, week and session appear in that order.",
            "order": 1
          },
          "t3-vscode.usage.pinnedAccounts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "window",
            "markdownDescription": "Accounts to keep in the status bar alongside the active conversation. Use [Configure Status Meters](command:t3-vscode.configureUsage) to choose accounts. Each account has its own meter; only reported quota windows are shown.",
            "order": 2
          },
          "t3-vscode.usage.refreshIntervalSeconds": {
            "type": "number",
            "default": 600,
            "minimum": 0,
            "scope": "window",
            "markdownDescription": "How often, in seconds, to refresh provider usage for the status bar meters while connected. Each wait adds up to 20% random jitter, so the default 600 means 600 to 720 seconds. Usage is also refreshed once when T3 VSCode connects. A refresh that falls due while a message is being sent or a response is running waits for the session to go idle, so it is far less likely to delay your messages; one is forced through once the meters are five intervals stale. Automatic refreshes also pause while no meter is displayed, and the waiting refresh runs as soon as one appears. Values from 1 to 14 are raised to 15; `0` disables periodic refresh. Changes apply immediately.",
            "order": 3
          }
        }
      },
      {
        "title": "Connection",
        "order": 4,
        "properties": {
          "t3-vscode.t3Home": {
            "type": "string",
            "default": "",
            "description": "T3 home directory (the server's data dir, default ~/.t3 or $T3CODE_HOME). Empty = auto. Change only to point at an isolated/dev server.",
            "order": 1
          }
        }
      }
    ],
    "icons": {
      "t3-vscode-codex": {
        "description": "T3 VSCode codex provider icon",
        "default": {
          "fontPath": "./resources/provider-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "t3-vscode-claude": {
        "description": "T3 VSCode claude provider icon",
        "default": {
          "fontPath": "./resources/provider-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "t3-vscode-kimi": {
